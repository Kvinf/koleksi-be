<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    Referenced explicitly rather than taken transitively through the JWT bearer package.
    The tests mint their own access tokens, so these are types this project uses directly,
    and a direct reference is what stops an unrelated upgrade of the authentication stack
    from silently changing the version underneath them. Versions match what Koleksi.Api
    already resolves.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koleksi.Api\Koleksi.Api.csproj" />
    <ProjectReference Include="..\..\src\Koleksi.Application\Koleksi.Application.csproj" />
    <ProjectReference Include="..\..\src\Koleksi.Domain\Koleksi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
