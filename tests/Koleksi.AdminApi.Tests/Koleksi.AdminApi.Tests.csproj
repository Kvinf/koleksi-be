<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Referenced directly, as in Koleksi.Api.Tests: the tests mint their own tokens, and a direct reference stops an
       unrelated upgrade of the authentication stack changing the version underneath them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koleksi.AdminApi\Koleksi.AdminApi.csproj" />
    <ProjectReference Include="..\..\src\Koleksi.Application\Koleksi.Application.csproj" />
    <ProjectReference Include="..\..\src\Koleksi.Domain\Koleksi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The Dicari fakes are the ones Koleksi.Api.Tests uses; linked rather than copied so there is one behaviour to keep true. -->
  <ItemGroup>
    <Compile Include="..\Koleksi.Api.Tests\Fakes\FakeAdapter.cs" Link="Fakes\FakeAdapter.cs" />
    <Compile Include="..\Koleksi.Api.Tests\Fakes\FakeBountyRepository.cs" Link="Fakes\FakeBountyRepository.cs" />
    <Compile Include="..\Koleksi.Api.Tests\Fakes\FakeBountyModerationStore.cs" Link="Fakes\FakeBountyModerationStore.cs" />
  </ItemGroup>

</Project>
