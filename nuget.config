<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins this repo's package sources, so a build never depends on what happens to be configured in a
  developer's global NuGet config. A machine-wide source that is unreachable (a company mirror on a
  VPN, say) otherwise fails restore with NU1900, which TreatWarningsAsErrors turns into a broken
  build. <clear/> drops every inherited source; only nuget.org is used. The lock files
  (packages.lock.json) still pin the exact versions and content hashes.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
