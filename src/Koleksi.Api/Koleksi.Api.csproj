<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Koleksi.Infrastructure\Koleksi.Infrastructure.csproj" />
    <ProjectReference Include="..\Koleksi.Application\Koleksi.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Lambda's provided.al2023 custom runtime requires the entrypoint executable to be
         named exactly "bootstrap" (infra's app-stack.ts sets handler: "bootstrap"). Setting
         it here means a self-contained publish produces that name directly, with no
         separate rename step to remember or forget. -->
    <AssemblyName>bootstrap</AssemblyName>
    <UserSecretsId>199e78c1-f0b1-42c4-8552-8877230ba836</UserSecretsId>
  </PropertyGroup>

</Project>
